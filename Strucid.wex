local box = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
box.Size = UDim2.new(0, 16, 0, 16)
box.Position = UDim2.new(0, 5, 0.5, -8)
box.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
box.BorderSizePixel = 1
box.BorderColor3 = Color3.fromRGB(55, 55, 55)
box.ZIndex = 5
box.Parent = frame
local fill = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
fill.Size = UDim2.new(1, -4, 1, -4)
