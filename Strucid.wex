TopBar.Parent = Main
local TopLine = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
TopLine.Size = UDim2.new(1, 0, 0, 1)
TopLine.Position = UDim2.new(0, 0, 1, 0)
TopLine.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
TopLine.BorderSizePixel = 0
TopLine.ZIndex = 3
TopLine.Parent = TopBar
local Title = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
Title.Size = UDim2.new(0, 200, 1, 0)
Title.Position = UDim2.new(0, 10, 0, 0)
Title.Text = (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.GothamMedium
Title.TextSize = 13
Title.TextXAlignment = Enum.TextXAlignment.Left
Title.BackgroundTransparency = 1
Title.ZIndex = 3
Title.Parent = TopBar
local CloseBtn = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
CloseBtn.Size = UDim2.new(0, 30, 0, 30)
CloseBtn.Position = UDim2.new(1, -30, 0, 0)
CloseBtn.BackgroundTransparency = 1
CloseBtn.Text = (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)
CloseBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
CloseBtn.Font = Enum.Font.GothamMedium
CloseBtn.TextSize = 14
CloseBtn.ZIndex = 3
CloseBtn.Parent = TopBar
CloseBtn.MouseButton1Click:Connect(function()
Config.FOVEnabled = false
updateFOVBinding()
Config.Fullbright = false
Config.NoFog = false
updateLighting()
Config.ESP = false
Config.ESPNames = false
updateESPState()
ScreenGui:Destroy()
end)
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 then
dragging = true
dragStart = input.Position
startPos = Main.Position
input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End then dragging = false end
end)
end
end)
TopBar.InputChanged:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
if input == dragInput and dragging then
local delta = input.Position - dragStart
Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
end)
UserInputService.InputBegan:Connect(function(input, processed)
if not processed and input.KeyCode == Config.ToggleKey then Main.Visible = not Main.Visible end
end)
local Sidebar = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
Sidebar.Size = UDim2.new(0, 120, 1, -31)
Sidebar.Position = UDim2.new(0, 0, 0, 31)
Sidebar.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Sidebar.BorderSizePixel = 0
Sidebar.ZIndex = 2
Sidebar.Parent = Main
local SideLine = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
SideLine.Size = UDim2.new(0, 1, 1, -31)
SideLine.Position = UDim2.new(0, 120, 0, 31)
SideLine.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
SideLine.BorderSizePixel = 0
SideLine.ZIndex = 3
SideLine.Parent = Main
local SidebarList = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
SidebarList.SortOrder = Enum.SortOrder.LayoutOrder
SidebarList.Parent = Sidebar
local Container = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
Container.Size = UDim2.new(1, -121, 1, -31)
Container.Position = UDim2.new(0, 121, 0, 31)
Container.BackgroundTransparency = 1
Container.ZIndex = 2
Container.Parent = Main
local tabs = {}
local function createTab(name)
local btn = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
btn.Size = UDim2.new(1, 0, 0, 30)
btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
btn.BorderSizePixel = 0
btn.Text = (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end) .. name
btn.TextColor3 = Color3.fromRGB(150, 150, 150)
btn.Font = Enum.Font.Gotham
btn.TextSize = 13
btn.TextXAlignment = Enum.TextXAlignment.Left
btn.LayoutOrder = #Sidebar:GetChildren()
btn.ZIndex = 3
btn.Parent = Sidebar
local highlight = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
highlight.Size = UDim2.new(0, 2, 1, 0)
highlight.BackgroundColor3 = Config.Accent
highlight.BorderSizePixel = 0
highlight.Visible = false
highlight.ZIndex = 4
highlight.Parent = btn
local page = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
page.Size = UDim2.new(1, -10, 1, -10)
page.Position = UDim2.new(0, 5, 0, 5)
page.BackgroundTransparency = 1
page.ScrollBarThickness = 4
page.ScrollBarImageColor3 = Color3.fromRGB(60, 60, 60)
page.BorderSizePixel = 0
page.Visible = false
page.ZIndex = 3
page.Parent = Container
local list = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
list.Padding = UDim.new(0, 5)
list.SortOrder = Enum.SortOrder.LayoutOrder
list.Parent = page
list:GetPropertyChangedSignal((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)):Connect(function()
page.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y)
end)
btn.MouseButton1Click:Connect(function()
for _, t in pairs(tabs) do
t.Page.Visible = false
t.Btn.TextColor3 = Color3.fromRGB(150, 150, 150)
t.Btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
t.Highlight.Visible = false
end
page.Visible = true
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
highlight.Visible = true
end)
tabs[name] = {Btn = btn, Page = page, Highlight = highlight}
return page
end
