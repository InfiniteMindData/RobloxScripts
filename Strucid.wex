end)
end
local function createSlider(tab, text, min, max, default, callback)
local frame = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
frame.Size = UDim2.new(1, 0, 0, 35)
frame.BackgroundTransparency = 1
frame.LayoutOrder = #tab:GetChildren()
frame.ZIndex = 4
frame.Parent = tab
local lbl = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
lbl.Size = UDim2.new(1, -10, 0, 15)
lbl.Position = UDim2.new(0, 5, 0, 0)
lbl.BackgroundTransparency = 1
lbl.Text = text
lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
lbl.Font = Enum.Font.Gotham
lbl.TextSize = 13
lbl.TextXAlignment = Enum.TextXAlignment.Left
lbl.ZIndex = 5
lbl.Parent = frame
local valLbl = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
valLbl.Size = UDim2.new(0, 50, 0, 15)
valLbl.Position = UDim2.new(1, -55, 0, 0)
valLbl.BackgroundTransparency = 1
valLbl.Text = tostring(default)
valLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
valLbl.Font = Enum.Font.Gotham
valLbl.TextSize = 13
valLbl.TextXAlignment = Enum.TextXAlignment.Right
valLbl.ZIndex = 5
valLbl.Parent = frame
local barbg = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
barbg.Size = UDim2.new(1, -10, 0, 4)
barbg.Position = UDim2.new(0, 5, 0, 22)
barbg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
barbg.BorderSizePixel = 0
barbg.ZIndex = 5
barbg.Parent = frame
local fill = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local pct = (default - min) / (max - min)
fill.Size = UDim2.new(pct, 0, 1, 0)
fill.BackgroundColor3 = Config.Accent
fill.BorderSizePixel = 0
fill.ZIndex = 6
fill.Parent = barbg
local btn = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
btn.Size = UDim2.new(1, 0, 1, 10)
btn.Position = UDim2.new(0, 0, 0, -5)
btn.BackgroundTransparency = 1
btn.Text = ""
btn.ZIndex = 7
btn.Parent = barbg
local sliding = false
local function update(input)
local pos = math.clamp((input.Position.X - barbg.AbsolutePosition.X) / barbg.AbsoluteSize.X, 0, 1)
local val = math.floor(min + (max - min) * pos)
fill.Size = UDim2.new(pos, 0, 1, 0)
valLbl.Text = tostring(val)
callback(val)
end
btn.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 then
sliding = true
update(input)
end
end)
btn.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
end)
UserInputService.InputChanged:Connect(function(input)
if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
end)
end
local function createButton(tab, text, callback)
local btn = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
btn.Size = UDim2.new(1, -10, 0, 25)
btn.Position = UDim2.new(0, 5, 0, 0)
btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
btn.BorderSizePixel = 1
btn.BorderColor3 = Color3.fromRGB(55, 55, 55)
btn.Text = text
btn.TextColor3 = Color3.fromRGB(220, 220, 220)
btn.Font = Enum.Font.Gotham
btn.TextSize = 12
btn.LayoutOrder = #tab:GetChildren()
btn.ZIndex = 5
btn.Parent = tab
btn.MouseButton1Click:Connect(callback)
end
local tabCombat = createTab((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local tabVisuals = createTab((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local tabPlayer = createTab((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local tabMisc = createTab((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
createLabel(tabCombat, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
createToggle(tabCombat, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), false, function(v)
Config.NoRecoil = v
applyWeaponMods()
end)
createToggle(tabCombat, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), false, function(v)
Config.NoSpread = v
applyWeaponMods()
end)
createToggle(tabCombat, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), false, function(v)
Config.RapidFire = v
applyWeaponMods()
end)
createSlider(tabCombat, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), 1, 10, 4, function(v)
Config.FireRateSpeed = v / 100
if Config.RapidFire then applyWeaponMods() end
end)
createLabel(tabVisuals, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
createToggle(tabVisuals, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), false, function(v)
Config.ESP = v
updateESPState()
end)
createToggle(tabVisuals, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), false, function(v)
Config.ESPNames = v
updateESPState()
end)
createLabel(tabVisuals, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
createToggle(tabVisuals, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), false, function(v)
Config.Fullbright = v
updateLighting()
end)
createToggle(tabVisuals, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), false, function(v)
Config.NoFog = v
updateLighting()
end)
createLabel(tabPlayer, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
createToggle(tabPlayer, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), false, function(v)
Config.SpeedHack = v
if not v and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)) then
LocalPlayer.Character.Humanoid.WalkSpeed = 16
end
end)
createSlider(tabPlayer, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), 16, 120, 16, function(v) Config.WalkSpeed = v end)
createToggle(tabPlayer, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), false, function(v)
Config.JumpHack = v
if not v and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)) then
LocalPlayer.Character.Humanoid.JumpPower = 50
end
end)
createSlider(tabPlayer, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), 50, 200, 50, function(v) Config.JumpPower = v end)
createLabel(tabPlayer, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
createToggle(tabPlayer, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), false, function(v)
Config.FOVEnabled = v
updateFOVBinding()
end)
createSlider(tabPlayer, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), 70, 120, 90, function(v)
Config.FOVValue = v
if Config.FOVEnabled then updateFOVBinding() end
end)
createLabel(tabMisc, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
createToggle(tabMisc, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), false, function(v)
Config.CrosshairEnabled = v
CrosshairHolder.Visible = v
end)
createSlider(tabMisc, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), 2, 14, 6, function(v)
Config.CrosshairSize = v
CrosshairDot.Size = UDim2.new(0, v, 0, v)
CrosshairDot.Position = UDim2.new(0.5, -v/2, 0.5, -v/2)
end)
createLabel(tabMisc, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
createButton(tabMisc, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), function() pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end) end)
createButton(tabMisc, (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), function() pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end) end)
tabs[(function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)].Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
tabs[(function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)].Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
tabs[(function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)].Highlight.Visible = true
tabs[(function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)].Page.Visible = true
