ScreenGui.Name = (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)
ScreenGui.DisplayOrder = 999999
ScreenGui.IgnoreGuiInset = true
ScreenGui.Parent = LocalPlayer:WaitForChild((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
ScreenGui.ResetOnSpawn = false
local CrosshairHolder = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
CrosshairHolder.Size = UDim2.new(0, 30, 0, 30)
CrosshairHolder.Position = UDim2.new(0.5, -15, 0.5, -15)
CrosshairHolder.BackgroundTransparency = 1
