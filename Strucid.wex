local Players = game:GetService((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local UserInputService = game:GetService((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local RunService = game:GetService((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local ReplicatedStorage = game:GetService((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local Workspace = game:GetService((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local Lighting = game:GetService((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local TeleportService = game:GetService((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local oldUI = LocalPlayer:WaitForChild((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)):FindFirstChild((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
if oldUI then oldUI:Destroy() end
local Config = {
NoRecoil = false,
NoSpread = false,
RapidFire = false,
FireRateSpeed = 0.04,
ESP = false,
ESPNames = false,
WalkSpeed = 16,
JumpPower = 50,
SpeedHack = false,
JumpHack = false,
FOVEnabled = false,
FOVValue = 90,
CrosshairEnabled = false,
CrosshairSize = 6,
CrosshairColor = Color3.fromRGB(0, 255, 170),
Fullbright = false,
NoFog = false,
Accent = Color3.fromRGB(115, 80, 255),
ToggleKey = Enum.KeyCode.RightControl
}
local origLighting = {
Brightness = Lighting.Brightness,
ClockTime = Lighting.ClockTime,
GlobalShadows = Lighting.GlobalShadows,
FogEnd = Lighting.FogEnd
}
local defaultFOV = 70
if Workspace.CurrentCamera then
defaultFOV = Workspace.CurrentCamera.FieldOfView
end
local originalWeaponStats = {}
local function saveOriginalWeaponStats()
local weaponsFolder = ReplicatedStorage:FindFirstChild((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
if not weaponsFolder then return end
local modulesFolder = weaponsFolder:FindFirstChild((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
if not modulesFolder then return end
for _, mod in ipairs(modulesFolder:GetChildren()) do
if mod:IsA((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)) then
local success, weaponTable = pcall(require, mod)
if success and type(weaponTable) == (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end) and not originalWeaponStats[mod.Name] then
originalWeaponStats[mod.Name] = {
Recoil = weaponTable.Recoil or 0,
WRecoil = weaponTable.WRecoil or 0,
Inaccuracy = weaponTable.Inaccuracy or 0,
Debounce = weaponTable.Debounce or 0.1
}
end
end
end
end
local function applyWeaponMods()
local weaponsFolder = ReplicatedStorage:FindFirstChild((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
if not weaponsFolder then return end
local modulesFolder = weaponsFolder:FindFirstChild((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
if not modulesFolder then return end
for _, mod in ipairs(modulesFolder:GetChildren()) do
if mod:IsA((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)) then
local success, weaponTable = pcall(require, mod)
if success and type(weaponTable) == (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end) then
local original = originalWeaponStats[mod.Name]
if original then
weaponTable.Recoil = Config.NoRecoil and 0 or original.Recoil
weaponTable.WRecoil = Config.NoRecoil and 0 or original.WRecoil
weaponTable.Inaccuracy = Config.NoSpread and 0 or original.Inaccuracy
weaponTable.Debounce = Config.RapidFire and Config.FireRateSpeed or original.Debounce
end
end
end
end
end
saveOriginalWeaponStats()
local function bindToolEquip(char)
if not char then return end
char.ChildAdded:Connect(function(child)
if child:IsA((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)) then
task.wait(0.05)
applyWeaponMods()
end
end)
end
if LocalPlayer.Character then bindToolEquip(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(bindToolEquip)
local function updateFOVBinding()
if Config.FOVEnabled then
pcall(function()
RunService:BindToRenderStep((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), Enum.RenderPriority.Camera.Value + 100, function()
if Workspace.CurrentCamera then
Workspace.CurrentCamera.FieldOfView = Config.FOVValue
end
end)
end)
else
pcall(function()
RunService:UnbindFromRenderStep((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
end)
if Workspace.CurrentCamera then
Workspace.CurrentCamera.FieldOfView = defaultFOV
end
end
end
local function updateLighting()
if Config.Fullbright then
Lighting.Brightness = 2
Lighting.ClockTime = 14
Lighting.GlobalShadows = false
else
Lighting.Brightness = origLighting.Brightness
Lighting.ClockTime = origLighting.ClockTime
Lighting.GlobalShadows = origLighting.GlobalShadows
end
Lighting.FogEnd = Config.NoFog and 999999 or origLighting.FogEnd
end
local esphighlights = {}
local espBillboardTags = {}
local function removeHighlight(userId)
if esphighlights[userId] then
if esphighlights[userId].Parent then esphighlights[userId]:Destroy() end
esphighlights[userId] = nil
end
if espBillboardTags[userId] then
if espBillboardTags[userId].Parent then espBillboardTags[userId]:Destroy() end
espBillboardTags[userId] = nil
end
end
local function applyESPToCharacter(player, char)
if not player or player == LocalPlayer or not char then return end
removeHighlight(player.UserId)
if not Config.ESP then return end
local humanoid = char:FindFirstChildOfClass((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
local head = char:FindFirstChild((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
if not humanoid or humanoid.Health <= 0 then return end
local highlight = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
highlight.Name = (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)
highlight.Adornee = char
highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
local teamColor = Color3.fromRGB(255, 50, 50)
if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
teamColor = Color3.fromRGB(50, 255, 50)
end
highlight.FillColor = teamColor
highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
highlight.FillTransparency = 0.6
highlight.OutlineTransparency = 0
highlight.Parent = char
esphighlights[player.UserId] = highlight
if head and Config.ESPNames then
local bb = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
bb.Name = (function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end)
bb.Adornee = head
bb.Size = UDim2.new(0, 200, 0, 20)
bb.StudsOffset = Vector3.new(0, 3, 0)
bb.AlwaysOnTop = true
local txt = Instance.new((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
txt.Size = UDim2.new(1, 0, 1, 0)
txt.BackgroundTransparency = 1
txt.Text = player.Name
txt.TextColor3 = teamColor
txt.Font = Enum.Font.Code
txt.TextSize = 12
txt.TextStrokeTransparency = 0
txt.Parent = bb
bb.Parent = char
espBillboardTags[player.UserId] = {Gui = bb, Label = txt, Player = player, Humanoid = humanoid, Head = head}
end
humanoid.Died:Connect(function() removeHighlight(player.UserId) end)
end
RunService.Heartbeat:Connect(function()
if Config.ESP and Config.ESPNames then
local localHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
for userId, data in pairs(espBillboardTags) do
if data and data.Label and data.Humanoid and data.Head then
local distStr = ""
if localHead then
local dist = math.floor((data.Head.Position - localHead.Position).Magnitude)
distStr = string.format((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), dist)
end
local hp = math.floor(data.Humanoid.Health)
data.Label.Text = string.format((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end), data.Player.Name, hp, distStr)
end
end
end
end)
local function updateESPState()
for userId in pairs(esphighlights) do removeHighlight(userId) end
if Config.ESP then
for _, player in ipairs(Players:GetPlayers()) do
if player.Character then applyESPToCharacter(player, player.Character) end
end
end
end
Players.PlayerAdded:Connect(function(player)
player.CharacterAdded:Connect(function(char)
if Config.ESP then task.wait(0.3) applyESPToCharacter(player, char) end
end)
end)
Players.PlayerRemoving:Connect(function(player) removeHighlight(player.UserId) end)
for _, player in ipairs(Players:GetPlayers()) do
if player ~= LocalPlayer then
player.CharacterAdded:Connect(function(char)
if Config.ESP then task.wait(0.3) applyESPToCharacter(player, char) end
end)
end
end
RunService.Heartbeat:Connect(function()
local char = LocalPlayer.Character
if char then
local humanoid = char:FindFirstChildOfClass((function(t,k)local s=""for i=1,#t do s=s..string.char(t[i]~(((k+i-1)%255)+1))end return s end))
if humanoid then
if Config.SpeedHack then humanoid.WalkSpeed = Config.WalkSpeed end
if Config.JumpHack then
humanoid.JumpPower = Config.JumpPower
humanoid.UseJumpPower = true
end
end
end
end)
